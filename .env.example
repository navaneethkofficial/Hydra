DATABASE_URL="postgresql://hydra:hydra@localhost:5433/hydra?schema=public"
# Optional locally (defaults to DATABASE_URL). On Vercel, DATABASE_URL is the
# provider's *pooled* string and DIRECT_URL the direct one, used for migrations.
# DIRECT_URL=""
AUTH_SECRET="generate-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Optional — when auth cookies are marked Secure: auto (default; Secure exactly
# when the request is HTTPS), always, or never. See README → AUTH_COOKIE_SECURE.
AUTH_COOKIE_SECURE="auto"

# Optional — enables the "Continue with Google" button when both are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — shared rate-limit counters, needed for limits to hold on Vercel.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
